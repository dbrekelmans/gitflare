{
  "name": "@gitflare/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The gitflare command line: log in, git credentials, sessions and capture.",
  "type": "module",
  "bin": {
    "gitflare": "./dist/gitflare.js"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "dev": "pnpm build && node dist/gitflare.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/cli/"
  },
  "dependencies": {
    "@gitflare/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gitflare/testing": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
