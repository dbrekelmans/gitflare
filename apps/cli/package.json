{
  "name": "gitflare",
  "version": "0.0.0",
  "private": true,
  "description": "The gitflare command line: log in, git credentials, sessions and capture.",
  "type": "module",
  "bin": {
    "gitflare": "./src/cli.ts"
  },
  "scripts": {
    "dev": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. apps/cli/"
  },
  "dependencies": {
    "@gitflare/core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
