#!/bin/sh
# git credential helper: one repo-scoped Artifacts token per repository path.
# Needs credential.useHttpPath=true, otherwise git does not send `path=`.
# Token files: $GF15/secrets/<repo-name>.token holding the full token
# (art_…?expires=…); the secret is the part before `?expires=`.
[ "$1" = get ] || exit 0
while IFS='=' read -r k v; do
  case "$k" in host) host=$v ;; path) path=$v ;; esac
done
echo "$(date -u +%H:%M:%S) get host=${host%%.*}.<…> path=$path" | sed -E 's/[0-9a-f]{32}/<account-id>/' >> "$GF15/helper.log"
repo=$(basename "${path%.git}")
f="${ARTIFACTS_TOKEN_DIR:-$GF15/secrets}/$repo.token"
[ -f "$f" ] || exit 0
tok=$(cat "$f")
printf 'username=x\npassword=%s\n' "${tok%%\?expires=*}"
